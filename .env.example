# Copy to .env and fill in values.

# development | production
APP_ENV=development
# SQLite database file, relative to the repo root (Postgres swap comes later)
DB_PATH=data/dev.db

# Better Auth (phone OTP). Must match the URL you browse to (host port mapping!)
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Meta WhatsApp Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose; Meta echoes it during webhook subscription
WHATSAPP_VERIFY_TOKEN=
